{
  "functions": {
    "api/cloudinary/[...media].ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/cloudinary/(.*)",
      "destination": "/api/cloudinary/[...media]"
    },
    {
      "source": "/admin(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}